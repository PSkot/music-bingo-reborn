# Copy this file to .env and fill in the values from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must be added exactly like this under "Redirect URIs" in your Spotify app settings.
# Spotify does not accept "localhost" - use 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/callback

# Any long random string; used to sign the session cookie.
FLASK_SECRET_KEY=change-me
